export sn="192.168.86"
export doq="quic://doh.archuser.org"
export doh="https://doh.archuser.org/dns-query"
export dot="tls://doh.archuser.org"

alias mrun='echo \#\!/bin/bash > run.sh && nano run.sh && chmod +x run.sh'
alias smrun='echo \#\!/bin/bash | sudo tee run.sh > /dev/null && sudo nano run.sh && sudo chmod +x run.sh'
