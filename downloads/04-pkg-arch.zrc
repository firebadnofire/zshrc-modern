__zmodules_add "04-pkg-arch.zrc" "Arch Package Manager"

echo "Packages to upgrade:"
pacman -Qu 2>/dev/null | wc -l

alias ins='sudo pacman -S'
package_update() { sudo pacman -Sy; }
alias pkgupdate='package_update'
alias upgrade='sudo pacman -Syu'
alias search='pacman -Ss'
alias rem='sudo pacman -Rsn'

PKGMGR='pacman, Arch Linux'
