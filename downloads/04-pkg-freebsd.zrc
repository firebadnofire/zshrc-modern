__zmodules_add "04-pkg-freebsd.zrc" "FreeBSD Package Manager"

echo "Packages to upgrade:"
/usr/sbin/pkg version | grep -v = | wc -l

alias ins='sudo pkg install'
package_update() { sudo pkg update; }
alias pkgupdate='package_update'
alias upgrade='sudo pkg upgrade'
alias search='sudo pkg search'
alias rem='sudo pkg delete'

PKGMGR='pkg, freebsd ports'
