__zmodules_add "04-pkg-opensuse-tumble.zrc" "OpenSUSE Package Manager"

if command -v zypper >/dev/null 2>&1; then
    echo "Packages to upgrade:"
    __zshrc_cached_eval "pkg-upgrades-opensuse" 1800 "zypper list-updates | grep -v '^Loading' | grep -v '^$' | wc -l"
fi

alias ins='sudo zypper install'
alias update='sudo zypper refresh'
alias upgrade='sudo zypper dup'   # use 'dup' if you run Tumbleweed
alias search='zypper search'
alias rem='sudo zypper remove'

PKGMGR='zypper, OpenSUSE'
