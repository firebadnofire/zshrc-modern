__zmodules_add "05-tools.zrc" "Tools"

export sn="192.168.86"
export doq="quic://doh.archuser.org"
export doh="https://doh.archuser.org/dns-query"
export dot="tls://doh.archuser.org"

alias mrun='echo \#\!/bin/bash > run.sh && nano run.sh && chmod +x run.sh'
alias smrun='echo \#\!/bin/bash | sudo tee run.sh > /dev/null && sudo nano run.sh && sudo chmod +x run.sh'

# Usage: pingoff host cmd
# Ping a host until up, then run a cmd
pingoff() {
    local host="$1"
    shift

    if [[ -z "$host" || $# -eq 0 ]]; then
        echo "Usage: pingoff <host> <command> [args...]"
        return 1
    fi

    echo "Waiting for $host to respond..."

    while true; do
        if ping -c 1 -W 1 "$host" >/dev/null 2>&1; then
            echo "$host is online"
            "$@"
            return $?
        fi

        sleep 1
    done
}

# Usage: mins <integer>
# Convert minutes to seconds
_time_to_seconds() {
    local name="${FUNCNAME[1]}"
    local amount="$1"
    local factor="$2"

    if [[ $# -ne 2 || ! "$amount" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        echo "Usage: $name <amount>" >&2
        return 1
    fi

    awk -v amount="$amount" -v factor="$factor" '
        BEGIN {
            seconds = amount * factor
            if (seconds == int(seconds))
                printf "%.0f\n", seconds
            else
                print seconds
        }
    '
}

mins()  { _time_to_seconds "$1" 60; }
hrs()   { _time_to_seconds "$1" 3600; }
days()  { _time_to_seconds "$1" 86400; }
weeks() { _time_to_seconds "$1" 604800; }

# Usage release tag_name
# release a git tag
release() {
  setopt localoptions err_return pipefail

  local ver="$1"

  if [[ -z "$ver" ]]; then
    print "Usage: git_release <version>"
    return 1
  fi

  if git rev-parse "$ver" >/dev/null 2>&1; then
    print "Tag $ver already exists"
    return 1
  fi

  git tag -a "$ver" -m "$ver"
  git push origin "$ver"
  git push

  print "Released $ver"
}

# Usage rerelease tag_name
# rerelease a git tag
rerelease () {
	setopt localoptions err_return pipefail

	local ver="$1"

	if [[ -z "$ver" ]]
	then
		print "Usage: rerelease <version>"
		return 1
	fi

	# Delete local tag if it exists
	if git rev-parse "$ver" >/dev/null 2>&1
	then
		git tag -d "$ver"
	fi

	# Delete remote tag if it exists
	git push origin ":refs/tags/$ver" || true

	# Recreate and push tag
	git tag -a "$ver" -m "$ver"
	git push origin "$ver"

	# Push current branch too, matching your release function
	git push

	print "Re-released $ver"
}
