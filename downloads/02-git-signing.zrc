__zmodules_add "${(%):-%N}"

gpg_key_id="none"
ssh_key="$HOME/.ssh/id_ed25519.pub"

if [ -f "$ssh_key" ]; then
    git config --global gpg.format ssh
    git config --global user.signingkey "$ssh_key"
    export gitsign=ssh
elif command -v gpg >/dev/null 2>&1 && gpg --list-keys 2>/dev/null | grep -q "$gpg_key_id"; then
    git config --global --unset gpg.format
    git config --global user.signingkey "$gpg_key_id"
    export gitsign=gpg
else
    export gitsign=none
fi
